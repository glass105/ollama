GITHUB_MEMORY_REPO=https://github.com/glass105/ollama.git
GITHUB_BRANCH=main
PUBLIC_KEY=
MEMORY_DIR=/workspace/ollama-memory
COMBINED_CONTEXT=/workspace/current_context.md
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_HOST=127.0.0.1:11434
ENABLE_MODEL_PULL=true
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
SYNC_INTERVAL_SECONDS=1800
ENABLE_OPENCLAW=true
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_GATEWAY_AUTH=token
OPENCLAW_ALLOWED_ORIGINS=
OPENCLAW_ALLOW_HOST_HEADER_ORIGIN_FALLBACK=false
OPENCLAW_PUBLIC_URL=
OPENCLAW_DASHBOARD_URL_FILE=/tmp/openclaw/dashboard-url
ENABLE_OPENCLAW_RAG_PROXY=true
OPENCLAW_RAG_PROXY_PORT=11437
OPENCLAW_RAG_QUERY_TIMEOUT_SECONDS=90
OPENCLAW_RAG_MAX_CONTEXT_CHARS=4000
OPENCLAW_RAG_MAX_QUESTION_CHARS=2000
ENABLE_ANYTHINGLLM=true
ENABLE_ANYTHINGLLM_PDF_AUTO_INDEX=true
ANYTHINGLLM_PUBLIC_PORT=3001
ANYTHINGLLM_INTERNAL_PORT=3010
ANYTHINGLLM_STORAGE_DIR=/workspace/anything-llm/server/storage
ANYTHINGLLM_PDF_DIR=/workspace/ollama-memory/PDFS
EQUIPMENT_FILE=/tmp/equipment.csv
EQUIPMENT_SSH_CONFIG=/tmp/equipment_ssh_config
# Optional equipment authentication files injected at runtime:
# EQUIPMENT_IDENTITY_FILE=/run/secrets/equipment_ssh_key
# EQUIPMENT_KNOWN_HOSTS_FILE=/run/secrets/equipment_known_hosts
# EQUIPMENT_STRICT_HOST_KEY_CHECKING=yes
ENABLE_EQUIPMENT_HTTPS_BRIDGE=false
EQUIPMENT_BRIDGE_HOST=0.0.0.0
EQUIPMENT_BRIDGE_PORT=19124
RUNPOD_READY_EXTRA_PORTS=19123 19124
START_BACKGROUND_SERVICES=true
WAIT_FOR_ANYTHINGLLM_BEFORE_OPENCLAW=false
START_MODEL_PULL_IN_BACKGROUND=true
# Optional fixed tokens. When empty, startup generates disposable pod-local tokens.
# EQUIPMENT_BRIDGE_CLIENT_TOKEN=
# EQUIPMENT_BRIDGE_WORKER_TOKEN=

# Optional S3-compatible RAG/vector cache. Do not commit real credentials in .env.
ENABLE_RAG_S3_CACHE=false
RAG_S3_CACHE_ID=lp8wr68ped
RAG_S3_REGION=us-nc-1
RAG_S3_ENDPOINT=https://s3api-us-nc-1.runpod.io
RAG_S3_BUCKET=lp8wr68ped
RAG_S3_PREFIX=ollama-rag-cache
RAG_S3_ARCHIVE_NAME=rag-vector-state.tar.gz
RAG_S3_RETENTION_COUNT=2
RAG_S3_ACCESS_KEY_ID=
RAG_S3_SECRET_ACCESS_KEY=
