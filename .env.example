GITHUB_MEMORY_REPO=https://github.com/glass105/ollama.git
GITHUB_BRANCH=main
MEMORY_DIR=/workspace/ollama-memory
COMBINED_CONTEXT=/workspace/current_context.md
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_HOST=0.0.0.0:11434
OPEN_WEBUI_MEMORY_PROXY_PORT=11435
OPEN_WEBUI_MEMORY_PROXY_NUM_CTX=8192
OPEN_WEBUI_MEMORY_PROXY_NUM_PREDICT=768
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_BOOTSTRAP_ADMIN=true
OPEN_WEBUI_ADMIN_EMAIL=joercoleman@mail.com
OPEN_WEBUI_ADMIN_NAME=Joseph Coleman
# Optional local secret. If unset, start.sh generates a pod-local password at /tmp/open-webui-admin-password.
# OPEN_WEBUI_ADMIN_PASSWORD=
ENABLE_MODEL_PULL=true
ENABLE_OPEN_WEBUI_FAST_RAG=true
OPEN_WEBUI_RAG_EMBEDDING_MODEL=nomic-embed-text:latest
OPEN_WEBUI_RAG_EMBEDDING_BATCH_SIZE=16
OPEN_WEBUI_RAG_EMBEDDING_CONCURRENT_REQUESTS=1
ENABLE_OPEN_WEBUI_PDF_AUTO_INDEX=true
OPEN_WEBUI_PDF_KNOWLEDGE_NAME=nokia
OPEN_WEBUI_PDF_KNOWLEDGE_DESCRIPTION=Git-backed PDF references
SYNC_INTERVAL_SECONDS=1800
ENABLE_OPENCLAW=true
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_ALLOWED_ORIGINS=
OPENCLAW_ALLOW_HOST_HEADER_ORIGIN_FALLBACK=false
